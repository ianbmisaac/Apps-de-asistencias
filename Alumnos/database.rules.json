{
  "rules": {
    "sesiones": {
      ".indexOn": ["codigo"],
      "$idSesion": {
        ".read": true,
        ".write": true,
        "alumnos": {
          "$idAlumno": {
            ".write": "!data.exists() || !newData.exists()"
          }
        }
      }
    },
    ".read": true,
    ".write": true
  }
}